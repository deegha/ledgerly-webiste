# Base URL of the Ledgerly app — the /get-started lead form's server action posts to
# `${NEXT_PUBLIC_APP_URL}/api/leads`. NEXT_PUBLIC_* vars are inlined at build time (server
# and client code alike), so this must be set before `next build`/`docker build`.
NEXT_PUBLIC_APP_URL=

# This marketing site's own public URL — used for metadataBase, canonical links,
# sitemap.xml, robots.txt, and JSON-LD. Defaults to https://ledgerly.lk if unset.
NEXT_PUBLIC_SITE_URL=

# GA4 Measurement ID (web stream "ledgerly.lk"). Inlined at build time. If unset or
# empty it falls back to the live ID G-11VTYDPV9P (the deploy workflow doesn't pass
# it yet). Set "off" to disable analytics. Analytics never loads under `next dev`
# unless NEXT_PUBLIC_GA_DEBUG=1. (NEXT_PUBLIC_GA_ID is read as a legacy alias.)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set to 1 to send analytics from `next dev` / non-production builds and enable
# GA DebugView. Leave unset normally so local testing doesn't hit real reports.
NEXT_PUBLIC_GA_DEBUG=
