# Base URL of the Ledgerly app — the primary CTA links to `${NEXT_PUBLIC_APP_URL}/onboarding`.
# NEXT_PUBLIC_* vars are inlined at build time, so this must be set before `next build`/`docker build`.
NEXT_PUBLIC_APP_URL=

# This marketing site's own public URL — used for metadataBase, canonical links,
# sitemap.xml, robots.txt, and JSON-LD. Defaults to https://ledgerly.lk if unset.
NEXT_PUBLIC_SITE_URL=
